---
interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  size?: 'large' | 'small';
  imageSrc?: string;
  imageAlt?: string;
}

const { title, subtitle, description, size = 'small', imageSrc, imageAlt = '' } = Astro.props;
const isLarge = size === 'large';
const hasImage = isLarge && Boolean(imageSrc);
---

<section class:list={["relative overflow-hidden wave-divider", isLarge ? "hero-aurora" : "bg-gradient-to-br from-primary-dark to-primary-dark"]}>
  {isLarge ? (
    <>
      <div class="aurora-bg"></div>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
    </>
  ) : (
    <>
      <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-accent/10"></div>
      <div class="absolute top-0 right-0 w-96 h-96 bg-primary/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-accent/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
    </>
  )}

  <div
    class:list={[
      "container mx-auto px-4 sm:px-6 relative z-10",
      hasImage
        ? "grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(320px,2fr)] items-center gap-12 lg:gap-6 py-16 sm:py-20 lg:py-16"
        : isLarge
          ? "py-28 md:py-40"
          : "py-16 md:py-24",
    ]}
  >
    <div class:list={[hasImage ? "text-center lg:text-left" : "text-center"]}>
      {subtitle && (
        <p class:list={["font-semibold text-accent mb-4 reveal", isLarge ? "text-lg md:text-xl" : "text-base"]}>
          {subtitle}
        </p>
      )}
      <h1
        class:list={[
          "font-bold leading-tight reveal reveal-delay-1",
          isLarge
            ? hasImage
              ? "text-4xl sm:text-5xl lg:text-5xl xl:text-6xl max-w-3xl mx-auto lg:mx-0 gradient-text"
              : "text-4xl md:text-7xl max-w-4xl mx-auto gradient-text"
            : "text-3xl md:text-5xl max-w-3xl mx-auto text-white",
        ]}
      >
        {title}
      </h1>
      {description && (
        <p
          class:list={[
            "text-white/70 reveal reveal-delay-2",
            hasImage ? "max-w-xl mx-auto lg:mx-0" : "max-w-2xl mx-auto",
            isLarge ? "text-lg md:text-xl mt-6" : "text-base md:text-lg mt-4",
          ]}
        >
          {description}
        </p>
      )}
      <div class:list={["reveal reveal-delay-3", hasImage ? "mt-8" : isLarge ? "mt-10" : "mt-6"]}>
        <slot />
      </div>
    </div>

    {hasImage && (
      <div class="hero-portrait-wrap relative w-full max-w-[460px] mx-auto lg:ml-0 reveal reveal-delay-2">
        <div class="hero-portrait-glow" aria-hidden="true"></div>
        <div class="hero-portrait aspect-[4/3] sm:aspect-[5/4] lg:aspect-[4/5]">
          <img
            src={imageSrc}
            alt={imageAlt}
            width="900"
            height="1353"
            class="absolute inset-0 h-full w-full object-cover object-[50%_20%] lg:object-[50%_35%]"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .hero-aurora {
    background: var(--color-primary-dark);
    position: relative;
  }

  .aurora-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% 120%, rgba(109, 74, 255, 0.3), transparent),
      radial-gradient(ellipse 60% 40% at 70% 20%, rgba(147, 109, 255, 0.2), transparent),
      radial-gradient(ellipse 50% 60% at 20% 60%, rgba(109, 74, 255, 0.15), transparent);
    background-size: 200% 200%;
    animation: aurora 15s ease infinite;
  }

  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.4;
  }

  .aurora-orb-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(109, 74, 255, 0.5), transparent 70%);
    top: -20%;
    right: -10%;
    animation: float 12s ease-in-out infinite;
  }

  .aurora-orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(147, 109, 255, 0.4), transparent 70%);
    bottom: -15%;
    left: -5%;
    animation: floatSlow 14s ease-in-out infinite;
  }

  .aurora-orb-3 {
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(91, 61, 230, 0.3), transparent 70%);
    top: 30%;
    left: 40%;
    animation: float 10s ease-in-out infinite reverse;
  }

  .hero-portrait-wrap {
    isolation: isolate;
  }

  .hero-portrait-glow {
    position: absolute;
    inset: 8% -6% -6% 12%;
    z-index: -1;
    border-radius: 3rem;
    background: rgba(147, 109, 255, 0.42);
    filter: blur(48px);
  }

  .hero-portrait {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: clamp(1.5rem, 3vw, 2.75rem);
    background: var(--color-primary-dark);
    box-shadow: 0 28px 70px rgba(9, 5, 35, 0.38);
  }

  .hero-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(34, 24, 84, 0.46) 0%, transparent 24%),
      linear-gradient(0deg, rgba(34, 24, 84, 0.72) 0%, transparent 26%);
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .hero-portrait::after {
      background: linear-gradient(0deg, rgba(34, 24, 84, 0.72) 0%, transparent 28%);
    }
  }
</style>
