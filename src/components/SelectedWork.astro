---
import { t, getLocalizedPaths, type Lang } from '../i18n';
import { projectMedia } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const paths = getLocalizedPaths(lang);
const projects = ['vozokany', 'viki', 'postwork'].map(id =>
  strings.projects.items.find(project => project.id === id)!
);
---

<section id="selected-work" class="selected-work" aria-labelledby="selected-work-title" data-analytics-section="selected_work">
  <div class="container mx-auto">
    <header class="work-heading">
      <h2 id="selected-work-title">{strings.home.selectedWorkTitle}</h2>
    </header>

    <div class="work-grid">
      {projects.map(project => {
        const media = projectMedia[project.id];
        return (
          <article class="work-card">
            <a class="work-link" href={`${paths.projects}#${project.id}`} aria-labelledby={`selected-${project.id}`}>
              <figure class="work-preview">
                <img src={media.image} alt={media.alt[lang]} width={media.width} height={media.height} loading="lazy" decoding="async" />
              </figure>
              <div class="work-copy">
                <div class="work-meta">
                  <p class="work-category">{project.eyebrow}</p>
                </div>
                <h3 id={`selected-${project.id}`}>{project.title}</h3>
                <p class="work-description">{project.preview}</p>
                <span class="work-cta">{strings.home.selectedWorkLink}<span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .selected-work { scroll-margin-top: 64px; padding: clamp(48px, 6vw, 88px) 24px clamp(64px, 7vw, 104px); background: var(--color-surface); }
  .work-heading { margin-bottom: 32px; }
  h2 { font-size: clamp(32px, 4vw, 48px); letter-spacing: -.04em; }
  .work-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .work-card { min-width: 0; border: 1px solid var(--color-border); border-radius: 16px; background: var(--color-surface); overflow: hidden; }
  .work-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .work-link:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -3px; border-radius: 16px; }
  .work-card:has(.work-link:hover), .work-card:focus-within { border-color: var(--color-primary); }
  .work-preview { margin: 0; padding: 0; overflow: hidden; border-radius: 15px 15px 0 0; background: var(--color-surface-alt); border-bottom: 1px solid var(--color-border); }
  .work-preview img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; object-position: top; border-radius: 15px 15px 0 0; }
  .work-copy { display: flex; flex-direction: column; flex: 1; padding: 24px; }
  .work-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 16px; }
  .work-category { flex: 1; color: var(--color-primary-hover); font-size: 11px; font-weight: 600; line-height: 1.5; }
  h3 { margin: 0 0 14px; font-size: 28px; letter-spacing: -.035em; }
  .work-description { margin: 0 0 28px; color: #514d5b; font-size: 14px; line-height: 1.8; }
  .work-cta { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 16px; color: var(--color-primary-hover); font-size: 13px; font-weight: 600; }
  .work-link:hover .work-cta { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1023px) {
    .work-grid { grid-template-columns: 1fr; max-width: 640px; }
  }
  @media (max-width: 480px) {
    .selected-work { padding-inline: 16px; }
    .work-copy { padding: 20px; }
  }
</style>
