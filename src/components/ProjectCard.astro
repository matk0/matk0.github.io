---
interface Props {
  title: string;
  mark: string;
  eyebrow: string;
  status: string;
  description: string;
  ownershipLabel: string;
  ownership: string;
  href: string;
  linkText: string;
  analyticsDestination: string;
}

const {
  title,
  mark,
  eyebrow,
  status,
  description,
  ownershipLabel,
  ownership,
  href,
  linkText,
  analyticsDestination,
} = Astro.props;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-border bg-surface p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/25 hover:shadow-xl hover:shadow-primary/10 sm:p-8">
  <div class="absolute right-0 top-0 h-40 w-40 rounded-bl-full bg-gradient-to-br from-primary/8 to-transparent transition-transform duration-500 group-hover:scale-110" aria-hidden="true"></div>

  <div class="relative z-10 flex h-full flex-col">
    <div class="mb-8 flex items-start justify-between gap-4">
      <div class="flex h-14 min-w-14 items-center justify-center rounded-2xl bg-primary-dark px-3 font-heading text-base font-bold tracking-tight text-white shadow-lg shadow-primary/15">
        {mark}
      </div>
      <span class="rounded-full border border-primary/15 bg-primary-light px-3 py-1.5 text-xs font-semibold text-primary">
        {status}
      </span>
    </div>

    <p class="mb-2 text-sm font-semibold uppercase tracking-[0.12em] text-primary">{eyebrow}</p>
    <h2 class="mb-4 text-2xl font-bold text-heading sm:text-3xl">{title}</h2>
    <p class="text-base leading-relaxed text-body">{description}</p>

    <div class="my-7 border-t border-border"></div>

    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-body">{ownershipLabel}</p>
    <p class="mb-7 text-sm leading-relaxed text-heading/80">{ownership}</p>

    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-auto inline-flex items-center gap-2 font-semibold text-primary transition-colors hover:text-primary-hover"
      data-analytics-event="external_link_clicked"
      data-analytics-destination={analyticsDestination}
      data-analytics-position="projects_grid"
    >
      {linkText}
      <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17 17 7M7 7h10v10" />
      </svg>
    </a>
  </div>
</article>
