---
import Layout from '../layouts/Layout.astro';
import { cv } from '../data/cv';
import type { Lang } from '../i18n';

const lang = ((Astro.locals as any).lang as Lang) || 'en';
const content = cv[lang];
---

<Layout title={content.pageTitle} description={content.metaDescription} lang={lang} currentPath="/cv">
  <div class="cv-page">
    <div class="cv-document">
      <header class="cv-header">
        <div class="cv-identity">
          <p class="cv-eyebrow">{content.eyebrow}</p>
          <h1>{content.name}</h1>
          <p class="cv-headline">{content.headline}</p>
        </div>
        <img
          class="cv-portrait"
          src="/images/hero-matej-portrait.webp"
          alt="Matej Lukášik"
          width="900"
          height="1353"
          loading="eager"
        />
        <address class="cv-contact">
          <p>{content.location}</p>
          <a href={`mailto:${content.email}`} aria-label={`${content.emailLabel}: ${content.email}`}>
            {content.email}
          </a>
          <a href={`tel:${content.phone}`} aria-label={`${content.phoneLabel}: ${content.phone}`}>
            {content.phone}
          </a>
        </address>
      </header>

      <section class="cv-section" aria-labelledby="cv-profile-heading">
        <h2 id="cv-profile-heading">{content.profileHeading}</h2>
        <div class="cv-prose">
          {content.profile.map(paragraph => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="cv-experience" aria-labelledby="cv-experience-heading">
        <h2 id="cv-experience-heading">{content.experienceHeading}</h2>
        <ol class="cv-entries">
          {content.entries.map(entry => (
            <li>
              <article class="cv-entry" aria-labelledby={`cv-${entry.id}`}>
                <div class="cv-entry-meta">
                  <p class="cv-period">{entry.period}</p>
                  <p class="cv-location">{entry.location}</p>
                </div>
                <div class="cv-entry-body">
                  <h3 id={`cv-${entry.id}`}>{entry.role}</h3>
                  <p class="cv-company">{entry.organization}</p>
                  <p class="cv-entry-summary">{entry.summary}</p>
                  {entry.highlights.length > 0 && (
                    <ul class="cv-highlights">
                      {entry.highlights.map(highlight => <li>{highlight}</li>)}
                    </ul>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>
</Layout>

<style>
  .cv-page { background: var(--color-surface); padding: 56px 24px 80px; }
  .cv-document { max-width: 1080px; margin: 0 auto; }
  .cv-header { display: grid; grid-template-columns: minmax(0, 1fr) 168px; column-gap: 64px; align-items: start; padding-bottom: 40px; }
  .cv-identity { padding-top: 6px; }
  .cv-eyebrow { margin: 0 0 16px; color: var(--color-primary); font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(36px, 4.2vw, 54px); letter-spacing: -.045em; }
  .cv-headline { max-width: 33ch; margin: 18px 0 0; font-size: 24px; line-height: 1.45; color: var(--color-primary-dark); }
  .cv-portrait { grid-column: 2; grid-row: 1 / 3; display: block; width: 168px; height: 200px; object-fit: cover; object-position: 50% 26%; border-radius: 20px; background: var(--color-surface-alt); }
  .cv-contact { display: flex; flex-wrap: wrap; gap: 8px 24px; grid-column: 1; margin-top: 24px; font-size: 13px; line-height: 1.65; font-style: normal; }
  .cv-contact p { flex-basis: 100%; margin: 0; }
  .cv-contact a { color: var(--color-primary-hover); text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .cv-contact a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 5px; border-radius: 2px; }
  .cv-section { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 40px; border-top: 1px solid var(--color-border); padding: 30px 0; }
  h2 { margin: 0; font-size: 19px; line-height: 1.4; }
  .cv-prose, .cv-entry-body { color: #514d5b; font-size: 15px; line-height: 1.8; }
  .cv-prose p { margin: 0 0 16px; }
  .cv-prose p:last-child { margin-bottom: 0; }
  .cv-experience { border-top: 1px solid var(--color-border); padding-top: 30px; }
  .cv-entries { margin: 24px 0 0; padding: 0; list-style: none; }
  .cv-entry { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 40px; padding: 30px 0; border-top: 1px solid var(--color-border); }
  .cv-entry-meta { padding-top: 3px; font-size: 12px; line-height: 1.7; }
  .cv-period { margin: 0; color: var(--color-primary-dark); font-weight: 600; }
  .cv-location { margin: 7px 0 0; }
  h3 { margin: 0; font-size: 22px; line-height: 1.3; }
  .cv-company { margin: 5px 0 14px; color: var(--color-primary-hover); font-size: 16px; font-weight: 600; line-height: 1.5; }
  .cv-entry-summary { margin: 0; }
  .cv-highlights { margin: 12px 0 0; padding-left: 20px; list-style: disc; }
  .cv-highlights li { padding-left: 3px; margin-top: 7px; }
  .cv-highlights li::marker { color: var(--color-primary); }
  @media (max-width: 760px) {
    .cv-header { column-gap: 24px; grid-template-columns: minmax(0, 1fr) 120px; }
    .cv-portrait { width: 120px; height: 152px; }
    .cv-headline { font-size: 20px; }
    .cv-section, .cv-entry { grid-template-columns: 1fr; gap: 18px; }
    .cv-entry-meta { display: flex; flex-wrap: wrap; gap: 5px 18px; }
    .cv-location { margin: 0; }
  }
  @media (max-width: 520px) {
    .cv-page { padding: 32px 20px 48px; }
    .cv-header { column-gap: 18px; padding-bottom: 30px; grid-template-columns: minmax(0, 1fr) 80px; }
    .cv-identity { display: contents; }
    .cv-eyebrow { grid-column: 1; margin-bottom: 14px; }
    h1 { grid-column: 1; font-size: 34px; line-height: 1.15; }
    .cv-portrait { grid-row: 1 / 3; width: 80px; height: 100px; border-radius: 12px; }
    .cv-headline { grid-column: 1 / -1; margin-top: 20px; max-width: 100%; font-size: 20px; }
    .cv-contact { grid-column: 1 / -1; gap: 7px 18px; margin-top: 20px; }
    .cv-section { padding: 26px 0; }
    .cv-experience { padding-top: 26px; }
    .cv-entry { gap: 14px; padding: 26px 0; }
    .cv-prose, .cv-entry-body { font-size: 14px; line-height: 1.8; }
    h3 { font-size: 21px; }
  }
</style>
