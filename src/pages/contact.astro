---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import CalEmbed from '../components/CalEmbed.astro';
import { t } from '../i18n';

const lang = 'en';
const strings = t(lang);
const service = Astro.url.searchParams.get('service') || undefined;
---

<Layout
  title="Contact — Matej Lukášik"
  description="Book a free 30-minute consultation or send me a message."
  lang={lang}
  currentPath="/contact"
>
  <Hero
    title={strings.contact.heroTitle}
    description={strings.contact.heroDescription}
  />

  <section class="section-padding bg-surface" data-analytics-section="contact_options">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <div>
          <CalEmbed title={strings.contact.bookTitle} description={strings.contact.bookDescription} lang={lang} />
        </div>
        <div>
          <h2 id="contact-form-heading" class="scroll-mt-20 text-xl font-bold text-heading mb-6">{strings.contact.formTitle}</h2>
          <ContactForm lang={lang} preselectedService={service} />
        </div>
      </div>
    </div>
  </section>

</Layout>
