---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PainCard from '../components/PainCard.astro';
import ServiceSection from '../components/ServiceSection.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import FirstStepOffer from '../components/FirstStepOffer.astro';
import CTABand from '../components/CTABand.astro';
import FAQ from '../components/FAQ.astro';
import { t, getLocalizedPaths } from '../i18n';
import type { Lang } from '../i18n';

const lang = (Astro.locals as any).lang as Lang || 'en';
const strings = t(lang);
const paths = getLocalizedPaths(lang);
const bookingHref = `${paths.contact}?focus=calendar`;
const socialLinks = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/matej-lukasik',
    destination: 'linkedin',
    iconPath: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
  {
    label: 'X',
    href: 'https://x.com/matejlukasik',
    destination: 'x',
    iconPath: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/matk0',
    destination: 'github',
    iconPath: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  },
  {
    label: 'YouTube',
    href: 'https://youtube.com/@matejlukasik',
    destination: 'youtube',
    iconPath: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
  },
];
---

<Layout
  title={strings.home.pageTitle}
  description={strings.home.heroDescription}
  lang={lang}
  currentPath="/"
>
  <Hero
    title={strings.home.heroTitle}
    description={strings.home.heroDescription}
    size="large"
    imageSrc="/images/hero-matej-portrait.webp"
    imageAlt="Matej Lukášik"
  >
    <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
      <a href="#services" class="btn-outline-white" data-analytics-event="services_intent_clicked" data-analytics-position="hero">
        {strings.home.ctaSecondary}
      </a>
      <a href={bookingHref} class="btn-white" data-analytics-event="booking_intent_clicked" data-analytics-position="hero" data-analytics-target="calendar">
        {strings.home.ctaPrimary}
      </a>
    </div>
  </Hero>

  <section class="section-padding bg-surface bg-dots relative" data-analytics-section="pain_points">
    <div class="container mx-auto">
      <h2 class="text-2xl md:text-4xl font-bold text-heading text-center mb-12 max-w-3xl mx-auto reveal">
        {strings.home.painTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="reveal reveal-delay-1">
          <PainCard imageSrc="/images/pain-clarity-consulting.webp" title={strings.home.pain1Title} description={strings.home.pain1Description} />
        </div>
        <div class="reveal reveal-delay-2">
          <PainCard imageSrc="/images/pain-value-automation.webp" title={strings.home.pain2Title} description={strings.home.pain2Description} />
        </div>
        <div class="reveal reveal-delay-3">
          <PainCard
            imageSrc="/images/pain-security-agent.webp"
            title={strings.home.pain3Title}
            description={strings.home.pain3Description}
          />
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="scroll-mt-[66px] py-8 md:py-10 bg-surface-alt relative" data-analytics-section="services">
    <div class="container mx-auto px-4 sm:px-6">
      <h2 class="text-2xl md:text-4xl font-bold text-center mb-8 md:mb-10 reveal">
        <span class="gradient-text-dark">{strings.home.servicesTitle}</span>
      </h2>

      <div class="space-y-6 md:space-y-8">
        <ServiceSection
          id="consulting"
          imageSrc="/images/service-strategy.webp"
          title={strings.services.consulting.title}
          subtitle={strings.services.consulting.subtitle}
          description={strings.services.consulting.description}
          includes={strings.services.consulting.includes}
          ctaText={strings.services.consulting.cta}
          ctaHref={bookingHref}
          ctaTarget="calendar"
          nested
        />

        <ServiceSection
          id="implementation"
          imageSrc="/images/service-implementation.webp"
          title={strings.services.implementation.title}
          subtitle={strings.services.implementation.subtitle}
          description={strings.services.implementation.description}
          includes={strings.services.implementation.includes}
          ctaText={strings.services.implementation.cta}
          ctaHref={`${paths.contact}?service=implementation&focus=contact-form`}
          reversed
          nested
        />

        <ServiceSection
          id="training"
          imageSrc="/images/service-training.webp"
          title={strings.services.training.title}
          subtitle={strings.services.training.subtitle}
          description={strings.services.training.description}
          includes={strings.services.training.includes}
          ctaText={strings.services.training.cta}
          ctaHref={`${paths.contact}?service=training&focus=contact-form`}
          nested
        />
      </div>
    </div>
  </section>

  <ProcessTimeline title={strings.home.processTitle} steps={strings.home.processSteps} />

  <FirstStepOffer offer={strings.home.firstStepOffer} href={bookingHref} />

  <section id="about" class="section-padding bg-surface" data-analytics-section="about">
    <div class="container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="reveal">
          <div class="w-full max-w-[560px] mx-auto">
            <div class="aspect-[4/5] max-h-[680px] rounded-2xl overflow-hidden bg-primary-light border border-border shadow-sm">
              <img src="/images/about-matej-portrait.webp" alt="Matej Lukášik" class="w-full h-full object-cover" />
            </div>
            <div class="mt-6 lg:mt-8 text-center">
              <h2 class="text-4xl md:text-5xl font-bold text-heading">{strings.about.bioName}</h2>
              <p class="mt-3 text-lg md:text-xl text-primary font-semibold">{strings.about.bioTitle}</p>
              <div class="mt-5 flex flex-wrap justify-center gap-2.5" aria-label={strings.footer.followMe}>
                {socialLinks.map((profile) => (
                  <a
                    href={profile.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-body transition-colors hover:border-primary hover:text-primary"
                    aria-label={profile.label}
                    data-analytics-event="external_link_clicked"
                    data-analytics-destination={profile.destination}
                    data-analytics-position="about_socials"
                  >
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d={profile.iconPath} />
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="reveal reveal-delay-1 max-w-2xl">
          {strings.about.bioText.split('\n\n').map((paragraph) => (
            <p class="text-body text-lg leading-relaxed mb-5 last:mb-0">{paragraph}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <FAQ title={strings.contact.faqTitle} items={strings.contact.faq} />

  <CTABand title={strings.home.ctaBandTitle} description={strings.home.ctaBandDescription}>
    <a href={bookingHref} class="btn-white" data-analytics-event="booking_intent_clicked" data-analytics-position="final_cta" data-analytics-target="calendar">
      {strings.home.ctaPrimary}
    </a>
  </CTABand>
</Layout>
