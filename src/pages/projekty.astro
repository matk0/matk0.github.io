---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import CTABand from '../components/CTABand.astro';
import { t, CONTACT_HREF } from '../i18n';

const lang = 'sk';
const strings = t(lang);
---

<Layout
  title={strings.projects.pageTitle}
  description={strings.projects.metaDescription}
  lang={lang}
  currentPath="/projekty"
>
  <Hero title={strings.projects.heroTitle} description={strings.projects.heroDescription} />

  <ProjectShowcase projects={strings.projects.items} ownershipLabel={strings.projects.ownershipLabel} lang={lang} />

  <CTABand title={strings.projects.ctaTitle} description={strings.projects.ctaDescription}>
    <a href={CONTACT_HREF} class="btn-white" data-analytics-event="mailto_clicked" data-analytics-position="projects_cta">{strings.projects.cta}</a>
  </CTABand>
</Layout>
